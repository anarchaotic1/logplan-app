{
  "appId": "com.hari.logplan",
  "appName": "Log/Plan",
  "webDir": "dist",
  "backgroundColor": "#010208",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#010208"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    },
    "LocalNotifications": {
      "iconColor": "#FFB35C"
    },
    "Keyboard": {
      "resizeOnFullScreen": true
    }
  }
}
